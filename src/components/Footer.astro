---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { services } from '../data/services';
const year = new Date().getFullYear();
---
<footer class="footer grain">
  <div class="container">
    <div class="top">
      <div class="col brand-col">
        <a href="/" aria-label="Over Barber Conceito — início"><img src="/brand/logo-over-barber-conceito.svg" width="1975" height="889" alt="" class="logo" loading="lazy" decoding="async" /></a>
        <p class="muted">{site.slogan} Barbearia premium no Meireles, em Fortaleza.</p>
        <div class="rating">
          <Icon name="google" size={22} />
          <div>
            <span class="stars" aria-hidden="true">{[1, 2, 3, 4, 5].map(() => <Icon name="star" size={14} />)}</span>
            <small><strong>{site.rating.value.replace('.', ',')}</strong> · {site.rating.count} avaliações no Google</small>
          </div>
        </div>
      </div>

      <div class="col">
        <p class="h">Serviços</p>
        <ul>
          {services.map((s) => <li><a href={`/servicos/${s.slug}/`}>{s.short}</a></li>)}
          <li><a href="/pacotes/">Pacotes Over</a></li>
          <li><a href="/dia-do-noivo/">Dia do Noivo</a></li>
        </ul>
      </div>

      <div class="col">
        <p class="h">A Over</p>
        <ul>
          <li><a href="/quem-somos/">Quem somos</a></li>
          <li><a href="/avaliacoes/">Avaliações</a></li>
          <li><a href="/galeria-de-fotos/">Galeria de fotos</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/perguntas-frequentes/">Perguntas frequentes</a></li>
          <li><a href="/contato/">Contato</a></li>
        </ul>
      </div>

      <div class="col">
        <p class="h">Visite</p>
        <address>
          <a href={site.mapsDirections} target="_blank" rel="noopener" class="ic"><Icon name="pin" size={18} /><span>{site.address.street}<br />{site.address.neighborhood}, {site.address.city} – {site.address.state}<br />CEP {site.address.zip}</span></a>
          <a href={`tel:${site.phoneE164}`} class="ic"><Icon name="phone" size={18} /><span>{site.phone}</span></a>
          <span class="ic"><Icon name="clock" size={18} /><span>{site.hours.map((h) => <>{h.days}: {h.time}<br /></>)}</span></span>
          <span class="ic"><Icon name="car" size={18} /><span>Valet gratuito para clientes</span></span>
        </address>
        <div class="social">
          <a href={site.instagram} target="_blank" rel="noopener" aria-label="Instagram da Over Barber Conceito"><Icon name="instagram" /></a>
          <a href={site.whatsappMsg()} target="_blank" rel="noopener" aria-label="WhatsApp da Over Barber Conceito"><Icon name="whatsapp" /></a>
          <a href={site.maps} target="_blank" rel="noopener" aria-label="Over Barber Conceito no Google Maps"><Icon name="google" /></a>
        </div>
      </div>
    </div>

    <div class="bottom">
      <p>© {year} {site.legalName}{site.cnpj ? ` · CNPJ ${site.cnpj}` : ''}. Todos os direitos reservados.</p>
      <ul>
        <li><a href="/politica-de-privacidade/">Privacidade</a></li>
        <li><a href="/politica-de-cookies/">Cookies</a></li>
        <li><a href="/termos-de-uso/">Termos de uso</a></li>
        <li><button type="button" data-cookie-open>Preferências de cookies</button></li>
      </ul>
    </div>
  </div>
</footer>

<a class="wa-float" href={site.whatsappMsg()} target="_blank" rel="noopener" aria-label="Falar no WhatsApp" data-track="whatsapp_float">
  <Icon name="whatsapp" size={28} />
  <span class="wa-tip">Agende pelo WhatsApp</span>
</a>

<style>
  .footer { position: relative; background: var(--navy-900); border-top: 1px solid var(--line); padding: clamp(3.5rem, 7vw, 5.5rem) 0 2rem; font-size: var(--fs-sm); }
  .top { display: grid; gap: 2.5rem; grid-template-columns: 1fr; }
  @media (min-width: 720px) { .top { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1080px) { .top { grid-template-columns: 1.4fr 1fr 1fr 1.3fr; } }
  .logo { height: 70px; width: auto; margin-bottom: 1.2rem; }
  .h { font-size: var(--fs-label); font-weight: 600; letter-spacing: 0.28em; text-transform: uppercase; color: var(--gold-300); margin-bottom: 1.1rem; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.55rem; }
  a { text-decoration: none; color: rgba(244, 230, 210, 0.8); }
  a:hover { color: var(--gold-300); }
  address { font-style: normal; display: grid; gap: 0.9rem; }
  .ic { display: flex; gap: 0.7rem; align-items: flex-start; color: rgba(244, 230, 210, 0.8); line-height: 1.55; }
  .ic :global(svg) { color: var(--gold); margin-top: 3px; flex: none; }
  .rating { display: flex; gap: 0.8rem; align-items: center; margin-top: 1.4rem; padding: 0.8rem 1rem; border: 1px solid var(--line); border-radius: 12px; width: fit-content; }
  .rating div { display: grid; line-height: 1.3; }
  .rating small { color: var(--muted); }
  .rating strong { color: var(--ivory); }
  .social { display: flex; gap: 0.6rem; margin-top: 1.4rem; }
  .social a { width: 44px; height: 44px; display: grid; place-items: center; border: 1px solid var(--line); border-radius: 50%; transition: border-color 0.3s, color 0.3s; }
  .social a:hover { border-color: var(--gold); }
  .bottom { margin-top: 3.5rem; padding-top: 1.6rem; border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; gap: 1rem 2rem; justify-content: space-between; align-items: center; color: var(--muted); font-size: var(--fs-xs); }
  .bottom p { margin: 0; }
  .bottom ul { display: flex; flex-wrap: wrap; gap: 0.4rem 1.4rem; }
  .bottom a, .bottom button { color: var(--muted); font-size: var(--fs-xs); }
  .bottom button { background: none; border: 0; padding: 0; cursor: pointer; text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 3px; }
  .bottom button:hover { color: var(--gold-300); }

  .wa-float {
    position: fixed; right: 18px; bottom: 18px; z-index: 90; width: 60px; height: 60px; border-radius: 50%;
    display: grid; place-items: center; color: #fff; background: #1fae5b;
    box-shadow: 0 12px 30px -8px rgba(0, 0, 0, 0.55); transition: transform 0.4s var(--ease);
  }
  .wa-float:hover { transform: scale(1.07); color: #fff; }
  .wa-float::before { content: ''; position: absolute; inset: 0; border-radius: 50%; border: 2px solid #1fae5b; animation: pulse 2.6s infinite; }
  .wa-tip { position: absolute; right: 72px; white-space: nowrap; background: var(--ivory); color: var(--navy-900); font-size: var(--fs-xs); font-weight: 600; padding: 0.45rem 0.8rem; border-radius: 8px; opacity: 0; transform: translateX(8px); transition: 0.3s var(--ease); pointer-events: none; }
  .wa-float:hover .wa-tip { opacity: 1; transform: none; }
  @keyframes pulse { 0% { transform: scale(1); opacity: 0.7; } 80%, 100% { transform: scale(1.55); opacity: 0; } }
</style>
