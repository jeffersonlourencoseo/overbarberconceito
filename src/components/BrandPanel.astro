---
// Painel da marca: substitui fotos em blocos laterais (emblema + destaque + detalhes).
interface Props { kicker?: string; title: string; lines?: string[]; facts?: { t: string; v: string }[]; class?: string }
const { kicker, title, lines = [], facts = [], class: cls } = Astro.props;
---
<div class:list={['bp reveal reveal-d1', cls]}>
  <img src="/brand/emblema-over-barber.svg" width="332" height="312" alt="" class="bp-emb" loading="lazy" decoding="async" />
  {kicker && <p class="bp-k">{kicker}</p>}
  <p class="bp-t" set:html={title} />
  {lines.map((l) => <p class="bp-l">{l}</p>)}
  {facts.length > 0 && (
    <dl class="bp-f">
      {facts.map((f) => <div><dt>{f.t}</dt><dd>{f.v}</dd></div>)}
    </dl>
  )}
</div>

<style>
  .bp { position: relative; display: grid; justify-items: center; align-content: center; text-align: center; min-height: 100%; padding: clamp(2.5rem, 6vw, 4rem) 2rem; border: 1px solid var(--line-strong); border-radius: calc(var(--radius) + 6px); background: radial-gradient(ellipse at 50% 0%, rgba(180, 139, 66, 0.18), transparent 65%), var(--navy-900); color: var(--cream); }
  .bp::before { content: ''; position: absolute; inset: 10px; border: 1px solid var(--line); border-radius: var(--radius); pointer-events: none; }
  .bp-emb { width: 60px; margin-bottom: 1.3rem; }
  .bp-k { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.3em; text-transform: uppercase; color: var(--gold-300); margin: 0 0 0.7rem; }
  .bp-t { font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3rem); line-height: 1.08; color: var(--ivory); margin: 0 0 0.8rem; }
  .bp-t :global(em) { font-style: italic; color: var(--gold-300); }
  .bp-l { color: var(--muted); margin: 0.15rem 0; }
  .bp-f { display: grid; grid-template-columns: repeat(auto-fit, minmax(90px, 1fr)); gap: 1rem; width: 100%; margin: 1.8rem 0 0; padding-top: 1.5rem; border-top: 1px solid var(--line); }
  .bp-f dt { font-size: 0.68rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--muted); }
  .bp-f dd { margin: 0.3rem 0 0; font-family: var(--font-display); font-size: 1.6rem; color: var(--gold-300); }
</style>
