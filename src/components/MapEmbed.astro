---
import Icon from './Icon.astro';
import { site } from '../data/site';
---
<div class="map" data-map>
  <div class="ph">
    <Icon name="pin" size={34} />
    <p><strong>{site.address.street}</strong><br />{site.address.neighborhood}, Fortaleza – CE · {site.address.zip}</p>
    <div class="btn-row">
      <button type="button" class="btn btn-ghost" data-map-load>Carregar mapa</button>
      <a class="btn btn-gold" href={site.mapsDirections} target="_blank" rel="noopener">Traçar rota</a>
    </div>
    <small>Ao carregar o mapa, o Google pode definir cookies. <a href="/politica-de-cookies/">Saiba mais</a>.</small>
  </div>
</div>
<script define:vars={{ src: site.mapsEmbed }}>
  document.querySelectorAll('[data-map]').forEach((m) => {
    m.querySelector('[data-map-load]')?.addEventListener('click', () => {
      m.innerHTML = `<iframe title="Mapa da Over Barber Conceito no Meireles, Fortaleza" src="${src}" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>`;
    });
  });
</script>
<style>
  .map { position: relative; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line-strong); min-height: 380px; height: 100%; background:
    radial-gradient(circle at 50% 45%, rgba(180, 139, 66, 0.18), transparent 55%),
    repeating-linear-gradient(0deg, rgba(244, 230, 210, 0.04) 0 1px, transparent 1px 44px),
    repeating-linear-gradient(90deg, rgba(244, 230, 210, 0.04) 0 1px, transparent 1px 44px), var(--navy-800); }
  .map :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; filter: grayscale(0.2) contrast(1.05); }
  .ph { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; text-align: center; gap: 0.9rem; padding: 2rem; }
  .ph > :global(svg) { color: var(--gold-300); }
  .ph p { margin: 0; color: var(--cream); }
  .ph small { color: var(--muted); font-size: var(--fs-xs); }
  .ph small a { color: var(--gold-300); }
  .btn-row { justify-content: center; }
</style>
