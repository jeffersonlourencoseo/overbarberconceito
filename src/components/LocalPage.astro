---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
import Icon from './Icon.astro';
import MapEmbed from './MapEmbed.astro';
import FaqList from './FaqList.astro';
import ReviewCard from './ReviewCard.astro';
import CtaBand from './CtaBand.astro';
import { site } from '../data/site';
import { services, brl } from '../data/services';
import { reviews } from '../data/reviews';
import { photo } from '../data/images';
import { faqSchema } from '../lib/schema';

interface Props {
  slug: string;
  bairro: string;
  seoTitle: string;
  seoDescription: string;
  h1: string;
  lead: string;
  intro: string[];
  route: string[];
  image: string;
  imageAlt: string;
  faq: { q: string; a: string }[];
  reviewNames: string[];
}
const p = Astro.props;
const crumbs = [{ name: 'Início', href: '/' }, { name: `Barbearia ${p.bairro}`, href: `/${p.slug}/` }];
const rv = reviews.filter((r) => p.reviewNames.includes(r.name));
---
<Base title={p.seoTitle} description={p.seoDescription} breadcrumbs={crumbs} schema={[faqSchema(p.faq)]}>
  <PageHero eyebrow={`Barbearia para quem é da ${p.bairro}`} title={p.h1} lead={p.lead} image={p.image} imageAlt={p.imageAlt} crumbs={crumbs}>
    <div class="btn-row" style="margin-top:2rem">
      <a class="btn btn-gold" href={site.booking} target="_blank" rel="noopener"><Icon name="calendar" /> Agendar horário</a>
      <a class="btn btn-ghost" href={site.mapsDirections} target="_blank" rel="noopener"><Icon name="pin" /> Rota até a Over</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="container split">
      <div class="reveal">
        <p class="eyebrow">Pertinho de você</p>
        <h2>Da {p.bairro} à Over <em class="accent">em poucos minutos.</em></h2>
        {p.intro.map((t) => <p class="lead">{t}</p>)}
        <ul class="route">{p.route.map((r) => <li><Icon name="check" size={18} /> {r}</li>)}</ul>
      </div>
      <div class="reveal reveal-d1 mapc"><MapEmbed /></div>
    </div>
  </section>

  <section class="section section--ivory">
    <div class="container">
      <header class="center reveal"><p class="eyebrow">Serviços</p><h2>O que você encontra <em class="accent">na Over</em></h2></header>
      <div class="svc">
        {services.map((s) => (
          <a href={`/servicos/${s.slug}/`} class="s reveal">
            {photo('servicos', s.slug) && <Image src={photo('servicos', s.slug)!} alt="" widths={[100, 160]} sizes="72px" />}
            <span><strong>{s.short}</strong><small>{s.items[0].name} · {brl(s.items[0].price)}</small></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {rv.length > 0 && (
    <section class="section section--navy">
      <div class="container">
        <header class="center reveal"><p class="eyebrow">Avaliações</p><h2>Quem é da região aprova</h2></header>
        <div class="grid grid-3" style="margin-top:2.5rem">{rv.map((r) => <div class="reveal"><ReviewCard r={r} /></div>)}</div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="narrow">
      <header class="center reveal"><p class="eyebrow">Dúvidas</p><h2>Barbearia na {p.bairro}: perguntas</h2></header>
      <FaqList items={p.faq} openFirst />
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .route { list-style: none; padding: 0; margin: 1.5rem 0 0; display: grid; gap: 0.7rem; }
  .route li { display: flex; gap: 0.7rem; align-items: flex-start; color: var(--cream); }
  .route :global(svg) { color: var(--gold); margin-top: 5px; flex: none; }
  .mapc { min-height: 420px; height: 100%; }
  .svc { display: grid; gap: 1rem; margin-top: 2.5rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); }
  .s { display: flex; gap: 1rem; align-items: center; padding: 0.7rem; background: #fff; border-radius: var(--radius-sm); border: 1px solid rgba(20, 27, 38, 0.08); text-decoration: none; color: var(--ink); transition: border-color 0.3s; }
  .s:hover { border-color: var(--gold); color: var(--ink); }
  .s :global(img) { width: 72px; height: 72px; object-fit: cover; border-radius: 8px; flex: none; }
  .s span { display: grid; line-height: 1.35; padding: 0.3rem 0.4rem; border-left: 2px solid var(--gold); padding-left: 0.9rem; }
  .s strong { font-family: var(--font-display); font-size: 1.3rem; font-weight: 600; color: var(--navy-900); }
  .s small { color: var(--muted-dark); }
</style>
