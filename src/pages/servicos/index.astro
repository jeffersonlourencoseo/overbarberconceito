---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import { services, packages, brl } from '../../data/services';
import { site } from '../../data/site';
import { abs } from '../../lib/schema';

const crumbs = [{ name: 'Início', href: '/' }, { name: 'Serviços', href: '/servicos/' }];
const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Serviços da Over Barber Conceito',
  itemListElement: services.map((s, i) => ({ '@type': 'ListItem', position: i + 1, url: abs(`/servicos/${s.slug}/`), name: s.title })),
};
---
<Base
  title="Serviços e Preços | Over Barber Conceito, Fortaleza"
  description="Tabela de serviços e preços da Over Barber Conceito: corte masculino R$ 80, barba R$ 80, cabelo e barba R$ 150, barboterapia, camuflagem, manicure e mais."
  breadcrumbs={crumbs}
  schema={[itemList]}
>
  <PageHero
    eyebrow="Serviços & preços"
    title="Tudo o que você precisa <em>em um só lugar.</em>"
    lead="Cabelo, barba, pele, unhas e tratamentos — com preços transparentes e agendamento online. Combine serviços e resolva tudo no mesmo horário."
    image="tesouras-e-pomadas"
    imageAlt="Tesouras, pentes e pomadas profissionais na bancada da Over Barber Conceito"
    crumbs={crumbs}
  >
    <nav class="jump" aria-label="Ir para categoria">
      {services.map((s) => <a href={`#${s.slug}`}>{s.short}</a>)}
    </nav>
  </PageHero>

  <section class="section">
    <div class="container list">
      {services.map((s, i) => (
        <article id={s.slug} class:list={['row reveal', { alt: i % 2, 'no-img': true }]}>
          <div class="row-body">
            <h2><a href={`/servicos/${s.slug}/`}>{s.short}</a></h2>
            <p class="muted">{s.excerpt}</p>
            <ul class="price-list">
              {s.items.map((it) => (
                <li><span class="name">{it.name}</span><span class="dots" /><span class="price">{brl(it.price)}</span>{it.desc && <span class="d">{it.desc}</span>}</li>
              ))}
            </ul>
            <a class="link-arrow" href={`/servicos/${s.slug}/`}>Saiba mais sobre {s.short.toLowerCase()}</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section section--ivory">
    <div class="container">
      <header class="center reveal">
        <p class="eyebrow">Pacotes</p>
        <h2>Combos com <em class="accent">vantagem.</em></h2>
      </header>
      <ul class="price-list pk reveal">
        {packages.map((p) => (
          <li><span class="name"><strong>{p.name}</strong></span><span class="dots" /><span class="price">{brl(p.price)}</span><span class="d">{p.items.join(' · ')}</span></li>
        ))}
      </ul>
      <div class="center" style="margin-top:2rem"><a class="btn btn-ghost" href="/pacotes/">Ver pacotes e Dia do Noivo</a></div>
      <p class="center muted small">Valores sujeitos a alteração sem aviso prévio. Confirme no <a href={site.booking} target="_blank" rel="noopener">agendamento online</a>.</p>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .jump { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 2rem; }
  .jump a { font-size: var(--fs-xs); font-weight: 600; text-decoration: none; padding: 0.5rem 0.95rem; border: 1px solid var(--line); border-radius: 999px; background: rgba(10, 16, 25, 0.5); transition: border-color 0.3s; }
  .jump a:hover { border-color: var(--gold); }
  .list { display: grid; gap: clamp(3.5rem, 8vw, 6rem); }
  .list:has(.row.no-img) { gap: 1.4rem; }
  .row { display: grid; gap: clamp(1.5rem, 5vw, 4rem); align-items: center; }
  @media (min-width: 900px) { .row { grid-template-columns: 0.85fr 1fr; } .row.alt .row-img { order: 2; } }
  .row-img { aspect-ratio: 4 / 3.6; }
  .row.no-img { grid-template-columns: 1fr; max-width: 860px; margin-inline: auto; width: 100%; padding: clamp(1.8rem, 4vw, 2.8rem); border: 1px solid var(--line); border-radius: var(--radius); background: linear-gradient(160deg, var(--navy-800), var(--navy-900) 65%); }
  .row h2 { font-size: clamp(2rem, 3.6vw, 2.8rem); margin-bottom: 0.2rem; }
  .row h2 a { text-decoration: none; color: inherit; }
  .row h2 a:hover { color: var(--gold-300); }
  .row .price-list { margin: 1rem 0 1.6rem; }
  .pk { max-width: 820px; margin: 2.5rem auto 0; }
  .small { font-size: var(--fs-sm); margin-top: 1.5rem; }
  .small a { color: var(--gold); }
</style>
