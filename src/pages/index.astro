  .map-col { height: 100%; min-height: 420px; }
</style>

<script>
  const track = document.querySelector('[data-rv-track]') as HTMLElement | null;
  const step = () => (track?.querySelector('.rv-item') as HTMLElement)?.offsetWidth + 19 || 300;
  document.querySelector('[data-rv-prev]')?.addEventListener('click', () => track?.scrollBy({ left: -step() }));
  document.querySelector('[data-rv-next]')?.addEventListener('click', () => track?.scrollBy({ left: step() }));
  // Vídeo de fundo: só baixa depois da página carregada e nunca com economia de dados,
  // conexão lenta ou preferência por menos movimento (fica a foto da fachada).
  const v = document.querySelector('[data-hero-video]') as HTMLVideoElement | null;
  const conn = (navigator as any).connection;
  const skip = matchMedia('(prefers-reduced-motion: reduce)').matches || conn?.saveData || /(^|-)2g$/.test(conn?.effectiveType || '');
  if (v && !skip) {
    const start = () => { v.src = v.dataset.src!; v.play().catch(() => {}); };
    if (document.readyState === 'complete') setTimeout(start, 300);
    else addEventListener('load', () => setTimeout(start, 300), { once: true });
  }
</script>
