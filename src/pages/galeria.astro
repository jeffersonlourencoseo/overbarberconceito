---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
import { img } from '../data/images';

const crumbs = [{ name: 'Início', href: '/' }, { name: 'Galeria', href: '/galeria/' }];
const photos: [string, string][] = [
  ['corte-masculino-texturizado', 'Corte masculino texturizado com volume — “Seu corte comunica antes mesmo de você falar”'],
  ['barba-na-navalha-detalhes', 'Barba sendo desenhada na navalha com cuidado nos detalhes'],
  ['antes-e-depois-corte', 'Antes e depois de corte e barba na Over Barber Conceito'],
  ['cliente-corte-masculino-perfil', 'Cliente de perfil com corte clássico penteado para trás'],
  ['fachada-over-barber-conceito', 'Letreiro da fachada da Over Barber Conceito na Av. Dom Luís'],
  ['ferramentas-barbeiro', 'Máquinas, tesouras e pentes organizados na bancada'],
  ['sua-melhor-versao', 'Barbeiro finalizando corte — “Sua melhor versão começa aqui”'],
  ['cliente-satisfeito-over-barber', 'Cliente satisfeito sorrindo após o atendimento'],
  ['acabamento-barba-maquina', 'Acabamento de barba com máquina'],
  ['ambiente-e-equipe', 'Equipe e ambiente da Over Barber Conceito'],
  ['lavagem-capilar', 'Lavagem capilar no lavatório'],
  ['corte-cabelo-masculino-salao', 'Cliente com cabelo cacheado e barba alinhada no salão'],
  ['tesouras-e-pomadas', 'Tesouras e pomadas profissionais'],
  ['barboterapia-relaxamento', 'Cliente relaxando durante barboterapia'],
  ['feedback-cliente-barbearia', 'Atendimento no salão com depoimento de cliente'],
  ['valet-gratuito-barbearia', 'Valet gratuito na porta da barbearia'],
  ['barba-e-cuidados-masculinos', 'Barba, ferramentas e cliente: tem corte que só tira o excesso'],
  ['cliente-barba-alinhada', 'Cliente com barba alinhada e corte social'],
];
const gallerySchema = {
  '@context': 'https://schema.org',
  '@type': 'ImageGallery',
  name: 'Galeria Over Barber Conceito',
  about: 'Cortes, barbas e ambiente da Over Barber Conceito no Meireles, Fortaleza',
};
---
<Base
  title="Galeria de Cortes, Barbas e Ambiente | Over Barber Conceito"
  description="Fotos de cortes masculinos, barbas na navalha, antes e depois e do ambiente da Over Barber Conceito, barbearia premium no Meireles, em Fortaleza."
  breadcrumbs={crumbs}
  schema={[gallerySchema]}
>
  <PageHero eyebrow="Galeria" title="Cuidado e atenção <em>nos detalhes.</em>" lead="Cortes, barbas, antes e depois e o ambiente da Over — registrados com clientes que autorizaram o uso de imagem." image="ambiente-e-equipe" imageAlt="Equipe e ambiente da Over Barber Conceito" crumbs={crumbs} />

  <section class="section">
    <div class="container">
      <div class="masonry">
        {photos.map(([n, alt], i) => (
          <figure class={`ph reveal reveal-d${i % 3}`}>
            <a href={img(n).src} data-lb aria-label={`Ampliar: ${alt}`}>
              <Image src={img(n)} alt={alt} widths={[360, 640]} sizes="(min-width: 1000px) 30vw, (min-width: 600px) 45vw, 92vw" />
            </a>
          </figure>
        ))}
      </div>
      <div class="btn-row" style="justify-content:center;margin-top:3rem">
        <a class="btn btn-gold" href={site.instagram} target="_blank" rel="noopener"><Icon name="instagram" /> Mais no Instagram</a>
      </div>
    </div>
  </section>

  <dialog class="lb" data-lb-dialog aria-label="Imagem ampliada">
    <button type="button" class="lb-x" aria-label="Fechar" data-lb-close><Icon name="close" size={26} /></button>
    <img alt="" data-lb-img />
  </dialog>

  <CtaBand />
</Base>

<script>
  const dlg = document.querySelector('[data-lb-dialog]') as HTMLDialogElement;
  const im = document.querySelector('[data-lb-img]') as HTMLImageElement;
  document.querySelectorAll<HTMLAnchorElement>('[data-lb]').forEach((a) =>
    a.addEventListener('click', (e) => {
      e.preventDefault();
      const i = a.querySelector('img')!;
      im.src = i.currentSrc || a.href; im.alt = i.alt;
      dlg.showModal();
    }),
  );
  dlg.addEventListener('click', (e) => { if (e.target === dlg || (e.target as HTMLElement).closest('[data-lb-close]')) dlg.close(); });
</script>

<style>
  .masonry { columns: 3 300px; column-gap: 1rem; }
  .ph { margin: 0 0 1rem; break-inside: avoid; border-radius: var(--radius-sm); overflow: hidden; }
  .ph a { display: block; cursor: zoom-in; }
  .ph :global(img) { width: 100%; height: auto; transition: transform 1s var(--ease), filter 0.5s; }
  .ph:hover :global(img) { transform: scale(1.04); }
  .lb { padding: 0; border: 0; background: transparent; max-width: 94vw; max-height: 92vh; }
  .lb::backdrop { background: rgba(5, 8, 13, 0.92); backdrop-filter: blur(6px); }
  .lb img { max-width: 94vw; max-height: 88vh; width: auto; height: auto; border-radius: 12px; }
  .lb-x { position: fixed; top: 16px; right: 16px; width: 48px; height: 48px; border-radius: 50%; border: 1px solid var(--line-strong); background: var(--navy-900); color: var(--cream); display: grid; place-items: center; cursor: pointer; }
</style>
